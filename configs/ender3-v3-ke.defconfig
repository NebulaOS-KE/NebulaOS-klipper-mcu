# NebulaOS Phase 1.7 - GD32F303RET6 target for the Creality Ender-3 V3 KE
#
# Seed config for `python3 lib/kconfiglib/olddefconfig.py src/Kconfig`
# (run via tools/ci_build.sh). Every other value - 120MHz clock, 512KB
# flash, 64KB RAM, app origin 0x08003000, 230400 baud, SWD auto-disable,
# hx71x/trigger_analog/sos_filter - follows from these via the Kconfig
# defaults added in this repo's GD32F303 patch commit (src/stm32/Kconfig,
# src/Kconfig): see the Phase 1.7 mission doc for the full derivation.
CONFIG_MACH_STM32=y
CONFIG_MACH_GD32F303=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_FLASH_START_3000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_SERIAL_USART2=y
